<page-meta root-font-size='system'>
	<navigation-bar title='{{wz}}域名模板' />
</page-meta>
<view wx:if='{{xs==false}}'>
	<mp-msg type='info' title='请登录账号' data-weui-theme='{{theme}}'></mp-msg>
</view>
<view wx:if='{{xs==true}}' class='page-container'>
	<view class='weui-cells__group weui-cells__group_form' data-weui-theme='{{theme}}'>
		<view class='weui-cells weui-cells_form'>
			<view class='weui-cell weui-cell_active'>
				<view class='weui-cell__hd'><label class='weui-label'>域名</label></view>
				<view class='weui-cell__bd'>
					<input model:value='{{ym}}' class='weui-input' focus='{{focus}}' placeholder='请输入域名' placeholder-class='weui-input__placeholder' bindblur='ym' />
				</view>
			</view>
			<view class='weui-cells__group weui-cells__group_form' data-weui-theme='{{theme}}'>
				<view class='weui-cells__title'>备注（选填）</view>
				<view class='weui-cells weui-cells_form'>
					<view class='weui-cell'>
						<view class='weui-cell__bd'>
							<textarea class='weui-textarea' placeholder='请输入备注' auto-height maxlength='20' placeholder-class='weui-input__placeholder' model:value='{{bz}}' bindinput='bz'></textarea>
							<view class='weui-textarea-counter'>{{count}}/20</view>
						</view>
					</view>
				</view>
			</view>
		</view>
	</view>
	<view class='a'>
		<text class='tag' wx:for='{{yuming}}'>{{item}} <text data-index='{{index}}' bindtap='sc' style='color:red'>×</text></text>
	</view>
	<button bindtap='tg' class='button' type='primary'>{{wz}}</button>
	<view class='d'>提示：</view>
	<view class='a'>1.域名支持通配符，如*.example.com。</view>
	<view class='a'>2.向CA提交证书签发请求时第一个域名将作为主域名，其余作为附加域名。</view>
	<view wx:if='{{wz=="新增"}}' class='a'>3.目前仅支持最多新增10个。</view>
</view>