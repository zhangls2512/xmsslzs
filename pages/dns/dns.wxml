<page-meta root-font-size='system'></page-meta>
<view wx:if='{{qx==false}}'>
	<mp-msg type='info' title='请登录账号' data-weui-theme='{{theme}}'></mp-msg>
</view>
<view wx:if='{{qx==true}}'>
	<button bindtap='sx' class='button'>刷新</button>
	<block wx:for='{{lb}}'>
		<view class='kuang'>
			<view class='a'>类型：{{item.yzlx}}</view>
			<view class='a'>记录名：<text bindtap='fz' data-id='{{item.name}}' style='color:#576b95'>{{item.name}}</text></view>
			<view class='a'>记录值：<text bindtap='fz' data-id='{{item.value}}' style='color:#576b95'>{{item.value}}</text></view>
			<view class='a'>授权状态：
				<text style='color:rgb(169,169,169)' wx:if='{{item.sqzt=="pending"}}'>待处理</text>
				<text style='color:rgb(26,173,25)' wx:if='{{item.sqzt=="valid"}}'>已通过</text>
				<text style='color:rgb(250,81,81)' wx:if='{{item.sqzt=="invalid"}}'>未通过</text>
				<text style='color:rgb(250,81,81)' wx:if='{{item.sqzt=="revoked"}}'>已撤销</text>
				<text style='color:rgb(250,81,81)' wx:if='{{item.sqzt=="deactivated"}}'>已停用</text>
				<text style='color:rgb(250,81,81)' wx:if='{{item.sqzt=="expired"}}'>已过期</text>
			</view>
			<view class='a'>验证状态：
				<text style='color:rgb(169,169,169)' wx:if='{{item.yzzt=="pending"}}'>待处理</text>
				<text style='color:rgb(255,145,41)' wx:if='{{item.yzzt=="processing"}}'>处理中</text>
				<text style='color:rgb(26,173,25)' wx:if='{{item.yzzt=="valid"}}'>已通过</text>
				<text style='color:rgb(250,81,81)' wx:if='{{item.yzzt=="invalid"}}'>未通过</text>
			</view>
			<view class='a'>验证截止时间：{{item.enddate}}</view>
			<view class='bpbutton'>
				<view wx:if='{{item.yzzt=="invalid"}}' data-id='{{item.errmsg}}' bindtap='reason' class='item1'>原因</view>
				<view wx:if='{{item.sqzt=="pending"}}' data-id='{{index}}' bindtap='tj' class='item1' style='color:rgb(26,173,25)'>提交验证</view>
			</view>
		</view>
	</block>
	<view class='listwz6'>——·——</view>
</view>