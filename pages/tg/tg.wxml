<page-meta root-font-size='system'></page-meta>
<view wx:if='{{xs==false}}'>
	<mp-msg type='info' title='请登录账号' data-weui-theme='{{theme}}'></mp-msg>
</view>
<view wx:if='{{xs==true}}' class='page-container'>
	<view class='weui-cells__group weui-cells__group_form' data-weui-theme='{{theme}}'>
		<view class='weui-cells weui-cells_form'>
			<view class='weui-cell weui-cell_active'>
				<view class='weui-cell__hd'><label class='weui-label'>域名</label></view>
				<view class='weui-cell__bd'>
					<input model:value='{{ym}}' class='weui-input' focus placeholder='请输入域名' placeholder-class='weui-input__placeholder' bindblur='ym' />
				</view>
			</view>
			<view class='weui-cell weui-cell_active weui-cell_select weui-cell_select-after'>
				<view class='weui-cell__hd'>
					<label class='weui-label' style='width:6em'>加密算法</label>
				</view>
				<view class='weui-cell__bd'>
					<picker header-text='当前可选择的加密算法' bindchange='picker' range='{{array}}'>
						<view class='weui-select'>{{sf}}</view>
					</picker>
				</view>
			</view>
		</view>
	</view>
	<view class='a'>
		<text class='tag' wx:for='{{yuming}}'>{{item}} <text data-index='{{index}}' bindtap='sc' style='color:red'>×</text></text>
	</view>
	<button bindtap='tg' class='button' type='primary'>新增</button>
	<view class='d'>提示：</view>
	<view class='a'>1.域名支持通配符，如*.example.com。</view>
	<view class='a'>2.向CA提交证书签发请求时第一个域名将作为主域名，其余作为附加域名。</view>
</view>