<page-meta root-font-size='system'></page-meta>
<view wx:if='{{xs==false}}'>
  <mp-msg type='info' title='请登录账号' data-weui-theme='{{theme}}'></mp-msg>
</view>
<view wx:if='{{xs==true}}' class='page-container'>
  <view class='weui-cells__group weui-cells__group_form' data-weui-theme='{{theme}}'>
    <view class='weui-cells weui-cells_form'>
      <view class='weui-cell weui-cell_active weui-cell_select weui-cell_select-after'>
        <view class='weui-cell__hd'>
          <label class='weui-label' style='width:6em'>方式</label>
        </view>
        <view class='weui-cell__bd'>
          <picker range='{{fsarray}}' bindchange='fspicker'>
            <view class='weui-select'>{{fs}}</view>
          </picker>
        </view>
      </view>
    </view>
  </view>
  <view wx:if='{{fs=="CSR"}}' class='weui-cells__group weui-cells__group_form' data-weui-theme='{{theme}}'>
    <view class='weui-cells__title'>CSR</view>
    <view class='weui-cells weui-cells_form'>
      <view class='weui-cell'>
        <view class='weui-cell__bd'>
          <textarea model:value='{{csr}}' class='weui-textarea' auto-height bindinput='mbdesc' placeholder='请输入CSR'
            placeholder-class='weui-input__placeholder'></textarea>
        </view>
      </view>
    </view>
  </view>
  <view wx:if='{{fs=="经典"&&lb.length>0}}' class='small-title'>模板</view>
  <button wx:if='{{fs=="经典"&&lb.length>0}}' class='button' type='warn' bindtap='yc'>隐藏</button>
  <block wx:if='{{fs=="经典"}}' wx:for='{{lb}}'>
    <view class='kuang'>
      <view class='a'>
        <text class='tag' wx:for='{{item.domains}}'>{{item}}</text>
      </view>
      <view class='a'>备注：{{item.desc}}</view>
      <view class='bpbutton'>
        <view class='item1' bindtap='tr' data-domains='{{item.domains}}'>填入</view>
      </view>
    </view>
  </block>
  <view class='weui-cells__group weui-cells__group_form' data-weui-theme='{{theme}}'>
    <view wx:if='{{fs=="经典"}}' class='weui-cells weui-cells_form'>
      <view class='weui-cell weui-cell_active'>
        <view class='weui-cell__hd'><label class='weui-label'>域名</label></view>
        <view class='weui-cell__bd'>
          <input model:value='{{domain}}' class='weui-input' bindblur='domain' placeholder='请输入域名/IP地址'
            placeholder-class='weui-input__placeholder'></input>
        </view>
      </view>
      <view class='weui-cell weui-cell_active weui-cell_switch'>
        <view class='weui-cell__bd'>添加模板</view>
        <view class='weui-cell__ft'>
          <label class='weui-switch-cp'>
            <switch bindchange='kg' class='weui-switch-cp__input' checked='{{xzmb}}'></switch>
            <view class='weui-switch-cp__box'></view>
          </label>
        </view>
      </view>
    </view>
  </view>
  <view wx:if='{{fs=="经典"}}' class='a'>
    <text wx:for='{{domains}}' class='tag'>{{item}} <text style='color:red' bindtap='sc'
        data-index='{{index}}'>×</text></text>
  </view>
  <view wx:if='{{fs=="经典"&&xzmb==true}}' class='weui-cells__group weui-cells__group_form' data-weui-theme='{{theme}}'>
    <view class='weui-cells__title'>模板备注（可选）</view>
    <view class='weui-cells weui-cells_form'>
      <view class='weui-cell'>
        <view class='weui-cell__bd'>
          <textarea model:value='{{mbdesc}}' class='weui-textarea' auto-height maxlength='20' bindinput='mbdesc'
            placeholder='请输入模板备注' placeholder-class='weui-input__placeholder'></textarea>
          <view class='weui-textarea-counter'>{{mbdesccount}}/20</view>
        </view>
      </view>
    </view>
  </view>
  <view class='weui-cells__group weui-cells__group_form' data-weui-theme='{{theme}}'>
    <view class='weui-cells__title'>订单备注（可选）</view>
    <view class='weui-cells weui-cells_form'>
      <view class='weui-cell'>
        <view class='weui-cell__bd'>
          <textarea model:value='{{orderdesc}}' class='weui-textarea' auto-height maxlength='20' bindinput='orderdesc'
            placeholder='请输入订单备注' placeholder-class='weui-input__placeholder'></textarea>
          <view class='weui-textarea-counter'>{{orderdesccount}}/20</view>
        </view>
      </view>
    </view>
  </view>
  <view class='weui-cells__group weui-cells__group_form' data-weui-theme='{{theme}}'>
    <view class='weui-cells weui-cells_form'>
      <view wx:if='{{fs=="经典"}}' class='weui-cell weui-cell_active weui-cell_select weui-cell_select-after'>
        <view class='weui-cell__hd'>
          <label class='weui-label' style='width:6em'>密钥类型</label>
        </view>
        <view class='weui-cell__bd'>
          <picker range='{{keytypearray}}' bindchange='keytypepicker'>
            <view class='weui-select'>{{keytypewz}}</view>
          </picker>
        </view>
      </view>
      <view wx:if='{{fs=="经典"&&keytype=="rsa"}}'
        class='weui-cell weui-cell_active weui-cell_select weui-cell_select-after'>
        <view class='weui-cell__hd'>
          <label class='weui-label' style='width:6em'>密钥位数</label>
        </view>
        <view class='weui-cell__bd'>
          <picker range='{{rsakeysizearray}}' bindchange='rsakeysizepicker'>
            <view class='weui-select'>{{rsakeysize}}</view>
          </picker>
        </view>
      </view>
      <view wx:if='{{fs=="经典"&&keytype=="ecdsa"}}'
        class='weui-cell weui-cell_active weui-cell_select weui-cell_select-after'>
        <view class='weui-cell__hd'>
          <label class='weui-label' style='width:6em'>密钥曲线</label>
        </view>
        <view class='weui-cell__bd'>
          <picker range='{{ecdsakeysizearray}}' bindchange='ecdsakeysizepicker'>
            <view class='weui-select'>{{ecdsakeysize}}</view>
          </picker>
        </view>
      </view>
      <view class='weui-cell weui-cell_active weui-cell_select weui-cell_select-after'>
        <view class='weui-cell__hd'>
          <label class='weui-label' style='width:6em'>环境类型</label>
        </view>
        <view class='weui-cell__bd'>
          <picker range='{{environmenttypearray}}' bindchange='environmenttypepicker'>
            <view class='weui-select'>{{environmenttypewz}}</view>
          </picker>
        </view>
      </view>
      <view class='weui-cell weui-cell_active weui-cell_select weui-cell_select-after'>
        <view class='weui-cell__hd'>
          <label class='weui-label' style='width:6em'>证书类型</label>
        </view>
        <view class='weui-cell__bd'>
          <picker range='{{certificatetypearray}}' bindchange='certificatetypepicker'>
            <view class='weui-select'>{{certificatetypewz}}</view>
          </picker>
        </view>
      </view>
      <view class='weui-cell weui-cell_active weui-cell_select weui-cell_select-after'>
        <view class='weui-cell__hd'>
          <label class='weui-label' style='width:6em'>自动续期</label>
        </view>
        <view class='weui-cell__bd'>
          <picker range='{{autoneworderarray}}' bindchange='autoneworderpicker'>
            <view class='weui-select'>{{autoneworderwz}}</view>
          </picker>
        </view>
      </view>
    </view>
  </view>
  <button class='button' type='primary' bindtap='xz'>新增</button>
</view>