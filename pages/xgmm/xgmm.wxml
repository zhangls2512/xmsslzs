<page-meta root-font-size='system'></page-meta>
<view wx:if='{{xs==false}}'>
	<mp-msg type='info' title='请登录账号' data-weui-theme='{{theme}}'></mp-msg>
</view>
<view wx:if='{{xs==true}}' class='page-container'>
	<mp-msg title='修改密码' data-weui-theme='{{theme}}'>
		<view slot='handle'>
			<view class='weui-cells__group weui-cells__group_form' data-weui-theme='{{theme}}'>
				<view class='weui-cells weui-cells_form'>
					<view class='weui-cell weui-cell_active'>
						<view class='weui-cell__hd'><label class='weui-label'>原密码</label></view>
						<view class='weui-cell__bd'>
							<input maxlength='16' model:value='{{ma}}' class='weui-input' password focus placeholder='请输入原密码' placeholder-class='weui-input__placeholder' />
						</view>
					</view>
					<view class='weui-cell weui-cell_active'>
						<view class='weui-cell__hd'><label class='weui-label'>新密码</label></view>
						<view class='weui-cell__bd'>
							<input maxlength='16' model:value='{{mb}}' class='weui-input' password placeholder='请输入新密码' placeholder-class='weui-input__placeholder' />
						</view>
					</view>
					<view class='weui-cell weui-cell_active'>
						<view class='weui-cell__hd'><label class='weui-label'>确认新密码</label></view>
						<view class='weui-cell__bd'>
							<input maxlength='16' model:value='{{mc}}' class='weui-input' password placeholder='请再次输入新密码' placeholder-class='weui-input__placeholder' />
						</view>
					</view>
				</view>
				<view class='weui-cells__tips'>
					<view bindtap='tz' class='weui-link'>忘记原密码？</view>
				</view>
			</view>
			<button bindtap='tj' class='button' type='primary'>修改</button>
		</view>
	</mp-msg>
</view>