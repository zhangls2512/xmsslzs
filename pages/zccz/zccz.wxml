<page-meta root-font-size='system'></page-meta>
<view class='page-container'>
	<view class='weui-cells__group weui-cells__group_form' data-weui-theme='{{theme}}'>
		<view class='weui-cells weui-cells_form'>
			<view class='weui-cell weui-cell_active'>
				<view class='weui-cell__hd'><label class='weui-label'>邮箱</label></view>
				<view class='weui-cell__bd'>
					<input model:value='{{email}}' class='weui-input' focus placeholder='请输入邮箱' placeholder-class='weui-input__placeholder' />
				</view>
			</view>
			<view class='weui-cell weui-cell_active'>
				<view class='weui-cell__hd'><label class='weui-label'>验证码</label></view>
				<view class='weui-cell__bd'>
					<input maxlength='6' model:value='{{yzm}}' class='weui-input' type='number' placeholder='请输入验证码' placeholder-class='weui-input__placeholder' />
				</view>
			</view>
			<view class='weui-cell weui-cell_active'>
				<view class='weui-cell__hd'><label class='weui-label'>密码</label></view>
				<view class='weui-cell__bd'>
					<input maxlength='16' model:value='{{password}}' class='weui-input' password placeholder='请输入密码' placeholder-class='weui-input__placeholder' />
				</view>
			</view>
		</view>
	</view>
	<button class='button' type='default' bindtap='fs'>发送验证码</button>
	<button class='button' type='primary' bindtap='tj'>提交</button>
	<checkbox-group class='b' bindchange='bindAgreeChange'>
		<checkbox bindtap='disagree' value='true' checked='{{agreefwtk}}' />
		<text>我已阅读并同意<text bindtap='ck1' style='color:#576b95'>《轩铭SSL证书软件许可及服务协议》</text>、<text bindtap='ck2' style='color:#576b95'>《轩铭SSL证书隐私保护指引》</text>、<text bindtap='ck3' style='color:#576b95'>《Let's Enctypt隐私政策》</text></text>
	</checkbox-group>
	<view class='b'>提交前请不要离开此页面，否则可能需要重新发送验证码</view>
	<view class='b'>未注册账号的邮箱在提交后系统会自动为其注册账号（账号密码为上方输入的密码）</view>
</view>