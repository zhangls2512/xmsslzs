<page-meta root-font-size='system'></page-meta>
<view wx:if='{{xs==false}}'>
	<mp-msg type='info' title='请登录账号' data-weui-theme='{{theme}}'></mp-msg>
</view>
<view wx:if='{{xs==true}}' class='page-container'>
	<view class='weui-cells__group weui-cells__group_form' data-weui-theme='{{theme}}'>
		<view class='weui-cells weui-cells_form'>
			<view class='weui-cell weui-cell_active weui-cell_select weui-cell_select-after'>
				<view class='weui-cell__hd'>
					<label class='weui-label' style='width:6em'>加密算法</label>
				</view>
				<view class='weui-cell__bd'>
					<picker header-text='当前可选择的加密算法' bindchange='picker' range='{{array}}' model:value='{{value}}'>
						<view class='weui-select'>{{sf}}</view>
					</picker>
				</view>
			</view>
			<view wx:if='{{suanfa=="ecdsap256"||suanfa=="ecdsap384"}}' class='weui-cell weui-cell_active weui-cell_switch'>
				<view class='weui-cell__bd'>使用ISRG Root X2作为证书链的根证书</view>
				<view class='weui-cell__ft'>
					<label class='weui-switch-cp'>
						<switch bindchange='kg' class='weui-switch-cp__input' checked='{{usex2}}' />
						<view class='weui-switch-cp__box'></view>
					</label>
				</view>
			</view>
		</view>
	</view>
	<button bindtap='xg' class='button' type='primary'>修改</button>
	<view class='a'>提示：目前仅支持ECDSA加密算法选择使用ISRG Root X2作为证书链的根证书。</view>
</view>