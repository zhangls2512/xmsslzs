<page-meta root-font-size='system'></page-meta>
<view wx:if='{{xs==false}}'>
  <mp-msg type='info' title='请登录账号' data-weui-theme='{{theme}}'></mp-msg>
</view>
<view wx:if='{{xs==true}}' class='page-container'>
  <view class='weui-cells__group weui-cells__group_form' data-weui-theme='{{theme}}'>
    <view class='weui-cells weui-cells_form'>
      <view wx:for='{{settings}}' class='weui-cell weui-cell_active weui-cell_switch'>
        <view class='weui-cell__bd'>{{item.namewz}}</view>
        <view class='weui-cell__ft'>
          <label class='weui-switch-cp'>
            <switch bindchange='change' data-name='{{item.name}}' class='weui-switch-cp__input'
              checked='{{item.value}}'></switch>
            <view class='weui-switch-cp__box'></view>
          </label>
        </view>
      </view>
      <view class='weui-cell weui-cell_active weui-cell_select weui-cell_select-after'>
        <view class='weui-cell__hd'>
          <label class='weui-label' style='width:6em'>自动提交挑战</label>
        </view>
        <view class='weui-cell__bd'>
          <picker model:value='{{value}}' range='{{array}}' bindchange='picker'>
            <view class='weui-select'>{{autosubmitchallengeverifywz}}</view>
          </picker>
        </view>
      </view>
    </view>
    <view class='weui-form__extra-area'>
      <view class='weui-footer'>
        <view class='weui-footer__links'>
          <view class='weui-footer__link' style='color:#576B95' bindtap='more'>更多选项</view>
        </view>
      </view>
    </view>
  </view>
</view>