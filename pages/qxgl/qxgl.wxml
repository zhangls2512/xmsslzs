					<switch class='weui-switch-cp__input' checked='{{yjc}}' disabled />
					<view class='weui-switch-cp__box'></view>
				</label>
			</view>
		</view>
	</view>
	<view wx:if='{{xs==true}}' class='weui-cells__tips'>
		<view bindtap='tz' class='weui-link'>前往邮件接收设置页面管理禁用项</view>
	</view>
</view>
