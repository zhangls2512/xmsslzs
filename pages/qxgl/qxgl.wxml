			<view class='weui-cell__bd'>- 验证码</view>
			<view class='weui-cell__ft'>
				<label class='weui-switch-cp'>
					<switch bindchange='yja' class='weui-switch-cp__input' checked='{{yja}}' />
					<view class='weui-switch-cp__box'></view>
				</label>
			</view>
		</view>
		<view wx:if='{{xs==true}}' class='weui-cell weui-cell_active weui-cell_switch'>
			<view class='weui-cell__bd'>- 申请状态变更通知</view>
			<view class='weui-cell__ft'>
				<label class='weui-switch-cp'>
					<switch class='weui-switch-cp__input' checked='{{yjb}}' disabled />
					<view class='weui-switch-cp__box'></view>
				</label>
			</view>
		</view>
		<view wx:if='{{xs==true}}' class='weui-cell weui-cell_active weui-cell_switch'>
			<view class='weui-cell__bd'>- 证书即将到期提醒</view>
			<view class='weui-cell__ft'>
