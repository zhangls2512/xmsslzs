<page-meta root-font-size='system'></page-meta>
<view wx:if='{{qx==false}}'>
	<mp-msg type='info' title='请先登录' data-weui-theme='{{theme}}'>
		<view slot='handle'>
			<button class='button' type='primary' bindtap='dl'>登录</button>
		</view>
	</mp-msg>
</view>
<view wx:if='{{qx==true}}'>
	<button class='button' type='primary' bindtap='add'>新增</button>
	<block wx:for='{{lb}}'>
		<view class='kuang'>
			<view class='a'>
				<text class='tag' wx:for='{{item.domains}}'>{{item}}</text>
			</view>
			<view class='a'>备注：{{item.desc}}</view>
			<view class='bpbutton'>
				<view class='item' bindtap='xg' data-id='{{item._id}}'>修改</view>
				<view class='item1' style='color:rgb(250,81,81)' bindtap='sc' data-id='{{item._id}}'>删除</view>
			</view>
		</view>
	</block>
	<view class='listwz6'>——·——</view>
</view>