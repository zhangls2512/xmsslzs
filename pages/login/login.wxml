<page-meta root-font-size='system'></page-meta>
<view class='weui-form' data-weui-theme='{{theme}}'>
  <view class='weui-form__text-area'>
    <view class='weui-form__title'>登录</view>
  </view>
  <view class='weui-form__control-area'>
    <view class='weui-cells__group weui-cells__group_form'>
      <view class='weui-cells weui-cells_form'>
        <view class='weui-cell weui-cell_active weui-cell_select weui-cell_select-after'>
          <view class='weui-cell__hd'>
            <label class='weui-label'>方式</label>
          </view>
          <view class='weui-cell__bd'>
            <picker range='{{types}}' bindchange='picker'>
              <view class='weui-select'>{{typewz}}</view>
            </picker>
          </view>
        </view>
        <view class='weui-cell weui-cell_active'>
          <view class='weui-cell__hd'><label class='weui-label'>邮箱</label></view>
          <view class='weui-cell__bd'>
            <input model:value='{{email}}' class='weui-input' placeholder='请输入邮箱'
              placeholder-class='weui-input__placeholder'></input>
          </view>
        </view>
        <view wx-if='{{type=="password"}}' class='weui-cell weui-cell_active'>
          <view class='weui-cell__hd'><label class='weui-label'>密码</label></view>
          <view class='weui-cell__bd'>
            <input model:value='{{code}}' class='weui-input' password maxlength='30' placeholder='请输入密码'
              placeholder-class='weui-input__placeholder'></input>
          </view>
        </view>
        <view wx-if='{{type=="mfa"}}' class='weui-cell weui-cell_active'>
          <view class='weui-cell__hd'><label class='weui-label'>MFA</label></view>
          <view class='weui-cell__bd'>
            <input model:value='{{code}}' class='weui-input' type='number' maxlength='6' placeholder='请输入MFA'
              placeholder-class='weui-input__placeholder'></input>
          </view>
        </view>
        <view wx-if='{{type=="emailcode"}}' class='weui-cell weui-cell_active'>
          <view class='weui-cell__hd'><label class='weui-label'>验证码</label></view>
          <view class='weui-cell__bd'>
            <input model:value='{{code}}' class='weui-input' type='number' maxlength='8' placeholder='请输入验证码'
              placeholder-class='weui-input__placeholder'></input>
          </view>
        </view>
      </view>
    </view>
  </view>
  <view class='weui-form__opr-area'>
    <button wx-if='{{type=="emailcode"}}' class='button' disabled='{{yzmzt}}' bindtap='hqyzm'>获取验证码</button>
    <button class='button' type='primary' bindtap='dl'>登录</button>
    <button class='button' type='default' bindtap='wxdl'>微信一键登录</button>
  </view>
  <view class='weui-form__extra-area'>
    <view class='weui-footer'>
      <view class='weui-footer__links'>
        <view class='weui-footer__link' style='color:#576B95' bindtap='zc'>注册账号</view>
      </view>
    </view>
  </view>
</view>