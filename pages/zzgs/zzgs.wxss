.table-container {
  display: flex;
  flex-direction: column;
  margin: 5px;
}

.row,
.endrow {
  border-top: 1px solid rgb(169, 169, 169);
  border-left: 1px solid rgb(169, 169, 169);
  border-right: 1px solid rgb(169, 169, 169);
  display: flex;
}

.endrow {
  border-bottom: 1px solid rgb(169, 169, 169);
}

.cell,
.cella,
.cellb,
.cellc {
  align-items: center;
  display: flex;
  flex: 1;
  justify-content: center;
  padding: 5px;
  text-align: center;
}

.cella,
.cellc {
  border-right: 1px solid rgb(169, 169, 169);
}

.cellb,
.cellc,
.lj {
  color: #576b95;
}