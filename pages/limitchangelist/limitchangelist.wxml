<page-meta root-font-size='system'></page-meta>
<view wx:if='{{qx==false}}'>
  <mp-msg type='info' title='请先登录' data-weui-theme='{{theme}}'>
    <view slot='handle'>
      <button class='button' type='primary' bindtap='dl'>登录</button>
    </view>
  </mp-msg>
</view>
<view wx:if='{{qx==true}}'>
  <block wx:for='{{lb}}'>
    <view class='kuang'>
      <view class='a'>类型：{{item.changeType}}</view>
      <view class='a'>数量：{{item.number}}</view>
      <view class='a'>原因：{{item.reason}}</view>
      <view class='a'>时间：{{item.date}}</view>
    </view>
  </block>
  <view class='listwz6'>——·——</view>
</view>